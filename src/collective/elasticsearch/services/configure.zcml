<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    >

  <include package="plone.restapi" />

  <adapter
      factory=".controlpanel.ElasticSearchSettingsConfigletPanel"
      name="elasticsearch"
      />

  <plone:service
      method="GET"
      factory=".elasticsearch.Info"
      for="Products.CMFCore.interfaces.ISiteRoot"
      permission="cmf.ManagePortal"
      name="@elasticsearch"
      />

  <plone:service
      method="POST"
      factory=".elasticsearch.Maintenance"
      for="Products.CMFCore.interfaces.ISiteRoot"
      permission="cmf.ManagePortal"
      name="@elasticsearch"
      />

  <adapter factory=".facets.ElasticSearchResultsSerializer" />

  <browser:page
      name="querybuilderresults"
      for="*"
      class=".facets.FacetsQueryBuilder"
      permission="zope2.View"
      layer="collective.elasticsearch.interfaces.IElasticSearchLayer"
      />

</configure>
